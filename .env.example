# Crypto Top Reversal Scanner — environment overrides
# 复制为 .env 后按需修改（.env 不会被提交到 git）

# 数据源: auto | fapi | vision
# auto = 先试 fapi.binance.com，不通则用 data.binance.vision 归档
CTSCAN_DATA_SOURCE=auto

# Binance USDT-M Futures REST（直连环境使用）
# FAPI_BASE=https://fapi.binance.com

# Binance 公共数据归档（fapi 不可达时使用）
# VISION_BASE=https://data.binance.vision
# VISION_S3_BASE=https://s3.ap-northeast-1.amazonaws.com/data.binance.vision

# CoinGecko（市值排名）
# COINGECKO_BASE=https://api.coingecko.com/api/v3

# 如果本机需要代理访问以上站点：
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# GitHub 同步时使用的仓库（仅提示用，Token 不要写在这里）
# GITHUB_REPO=yourname/crypto-top-scanner
